# === WireGuard ===
# VPS public IP or domain name
WG_SERVER_URL=your-vps-ip-or-domain
WG_SERVER_PORT=51820
# Comma-separated names for WG peers (direct WG clients: phone, laptop, etc.)
WG_PEERS=phone,laptop,pc

# === PPTP (for router) ===
PPTP_USERNAME=router
PPTP_PASSWORD=change-me-strong-password

# === Optional: External WireGuard VPN ===
# If you want to route ALL traffic through an external WG VPN provider
# set this to "true" and place the provider's .conf in configs/wg-upstream/
WG_UPSTREAM_ENABLED=false
